# Required: Telegram
TELEGRAM_BOT_TOKEN=
# Get this numeric ID from @userinfobot. Only this user can operate the bot.
TELEGRAM_ALLOWED_USER_ID=

# Required: OpenAI
OPENAI_API_KEY=
# Recommended economical default. Check current model lifecycle before changing this value.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_OUTPUT_TOKENS=2000

# Responsiveness and image handling
ASSISTANT_TIMEOUT_SECONDS=90
# Maximum is 20 MiB because of Telegram Bot API getFile limits. Default stays lower for memory safety.
TELEGRAM_IMAGE_MAX_BYTES=10485760
# A photo sent without a caption is kept only in memory for the next text question.
TELEGRAM_PENDING_IMAGE_SECONDS=600
# Telegram message edits are throttled to avoid rate limits.
TELEGRAM_PROGRESS_UPDATE_MS=1200
# Shows detailed live stages; /trace on can override this per chat.
TRACE_ENABLED_DEFAULT=false

# Storage and behavior
DATABASE_PATH=./data/assistant.sqlite
# Byte file vault disimpan terpisah dari metadata SQLite. Keduanya harus berada di volume persisten.
VAULT_STORAGE_PATH=./data/vault
# Gunakan s3 untuk menyimpan byte file baru di Railway Bucket; SQLite tetap berada di Volume.
VAULT_STORAGE_BACKEND=local
VAULT_OBJECT_PREFIX=approved/
# Railway Bucket: referensikan BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID, dan SECRET_ACCESS_KEY.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Telegram Bot API getFile membatasi download bot hingga 20 MiB.
VAULT_MAX_FILE_BYTES=20971520
ATTACHMENT_ANALYSIS_ENABLED=true
ATTACHMENT_PROCESSING_TIMEOUT_SECONDS=120
VIDEO_MAX_DURATION_SECONDS=120
VIDEO_MAX_FRAMES=6
FFMPEG_PATH=ffmpeg
MAX_VAULT_CONTEXT_ITEMS=12

# Dashboard lokal tersedia di http://127.0.0.1:3030 secara default.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
PORT=3030
# Wajib bila DASHBOARD_HOST bukan loopback (Docker/cloud). Gunakan secret acak yang panjang.
DASHBOARD_TOKEN=
# Docker perlu bind ke seluruh interface di dalam container; port host tetap dibatasi ke localhost.
DOCKER_DASHBOARD_HOST=0.0.0.0

LOG_LEVEL=info
TIMEZONE=Asia/Jakarta
MAX_HISTORY_MESSAGES=16
# Batas karakter riwayat yang dikirim ke model agar forward teks panjang tidak memenuhi konteks.
MAX_HISTORY_CHARS=60000
MAX_MEMORY_ITEMS=20
MESSAGE_RETENTION_DAYS=90

# Gmail (optional until connected with `npm run gmail:auth`)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_REFRESH_TOKEN=
GMAIL_POLL_SECONDS=120
GMAIL_MATCH_THRESHOLD=0.72
GMAIL_MAX_BODY_CHARS=6000
EMAIL_MAX_RETRIES=3
# Hard deadline for each semantic email classification request.
EMAIL_CLASSIFIER_TIMEOUT_SECONDS=30

# Web search. SearXNG is the credential-free default; Brave is an optional hosted alternative.
SEARCH_PROVIDER=searxng
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=http://localhost:8080
# Used only by Docker Compose; keep the service DNS name unless SearXNG is external.
DOCKER_SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=
SEARCH_RESULT_LIMIT=5
