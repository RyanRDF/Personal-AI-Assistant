{
  "name": "personal-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Telegram AI assistant with Gmail monitoring, durable memory, and web search.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "searxng:secret": "tsx scripts/generate-secret.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@grammyjs/runner": "^2.0.3",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "file-type": "^22.0.2",
    "googleapis": "^156.0.0",
    "grammy": "^1.38.2",
    "openai": "^5.12.2",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.1",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
